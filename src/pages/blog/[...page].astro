---
import type { GetStaticPaths } from "astro";
import PostListing from "../../components/PostListing.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getPostListingPaths } from "../../utils/content-utils";

// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992
export const getStaticPaths = getPostListingPaths satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainGridLayout>
    <PostListing page={page}></PostListing>
</MainGridLayout>

