---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

const githubRepository: string | undefined = process.env.GITHUB_REPOSITORY;
const commitSha: string | undefined = process.env.GITHUB_SHA;
const commitShaShort: string | undefined = commitSha?.trim()?.slice(0, 7);
const commitUrl: string | null =
	githubRepository && commitSha
		? `https://github.com/${githubRepository}/commit/${commitSha}`
		: null;
---

<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<div class="transition border-dashed border-[oklch(85%_0_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-(--primary) font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-(--primary) font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-(--primary) font-medium" target="_blank" href="https://astro.build"> Astro</a> &
        <a class="transition link text-(--primary) font-medium" target="_blank" href="https://github.com/saicaca/fuwari"> Fuwari</a>
        {
        commitSha && (
        <div>
            Version: { commitUrl ? <a class="transition link text-(--primary) font-medium" target="_blank" href=commitUrl>{commitShaShort}</a> : commitShaShort  }
        </div>
        )
        }
    </div>
</div>
